# Postgres de Supabase. `DATABASE_URL` apunta al connection pooler
# (Settings → Database → Connection string → "Transaction" mode, puerto
# 6543, con "?pgbouncer=true" al final) — es la que usa la app en runtime.
# `DIRECT_DATABASE_URL` apunta a la conexión directa (puerto 5432, sin
# pgbouncer) — la usan `prisma migrate`/`db push`, que no funcionan bien a
# través del pooler en modo transaction.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"
PORT=4000

# TMDB: solo el backend lo usa. Nunca se expone al frontend.
TMDB_API_KEY="tu_tmdb_api_key_aca"

# Opcional: Streaming Availability API (RapidAPI).
STREAMING_AVAILABILITY_API_KEY=""

DEFAULT_COUNTRY="AR"

# Secreto compartido para disparar los jobs de sincronización vía HTTP
# (POST /internal/sync/:job con header X-Sync-Secret).
SYNC_SECRET="cambia_este_secreto"

# "true" en un VPS donde el server corre siempre (usa node-cron interno).
# "false" en hosting compartido: programar un Cron Job de hPanel (o un cron
# externo) que pegue al endpoint /internal/sync/:job en su lugar.
ENABLE_INTERNAL_CRON="false"

# Cuentas de usuario (JWT) — generá un secreto random propio en producción.
JWT_SECRET="cambia_este_secreto_tambien"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Google/Apple Sign-In: arquitectura preparada, pero /auth/google y
# /auth/apple devuelven 501 hasta que se completen estas dos.
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# Detección de país por IP (ip-api.com, gratis, sin key).
GEOIP_BASE_URL="http://ip-api.com/json"

# Emails transaccionales (bienvenida + recuperar contraseña) vía Resend.
# Sin RESEND_API_KEY, el envío se salta silenciosamente (no bloquea
# registro/login). Mientras no haya un dominio propio verificado en
# resend.com/domains, "onboarding@resend.dev" solo entrega a la casilla
# dueña de la cuenta de Resend — no a usuarios reales.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="NowSee <onboarding@resend.dev>"
# URL pública del frontend (Vercel) — se usa para armar los links de los
# emails ("Entrar a NowSee", recuperar contraseña).
FRONTEND_URL="https://nowsee.vercel.app"
PASSWORD_RESET_TTL_MINUTES=120

# Caché compartida (Upstash Redis, REST API — no requiere conexión TCP
# persistente, hecha para funciones serverless). Sin estas dos, el backend
# sigue funcionando con una caché en memoria del proceso (suficiente en un
# server siempre-vivo, pero NO sobrevive entre invocaciones serverless de
# Vercel — ver src/utils/cache.ts).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
